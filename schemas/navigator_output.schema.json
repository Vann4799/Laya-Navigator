{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vann4799/laya-navigator/schema/navigator-output.json",
  "title": "Laya Navigator Output",
  "type": "object",
  "required": ["page_state", "goal", "next_action", "blocked", "confidence"],
  "properties": {
    "page_state": {"type": "string"},
    "goal": {"type": "string"},
    "next_action": {"type": "string"},
    "blocked": {"type": "boolean"},
    "blocking_reason": {"type": ["string", "null"]},
    "completion_progress": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
